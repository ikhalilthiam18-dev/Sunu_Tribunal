# SunuTribunal — variables de production (VPS)
# Copier en .env.production SUR LE SERVEUR, remplir, ne jamais committer.

# ── Adresse ─────────────────────────────────────
# Site : https://DOMAINE  — API et Django Admin : https://api.DOMAINE
# Avant l'achat du domaine : <IP-avec-tirets>.sslip.io (ex. 51-75-12-34.sslip.io)
DOMAINE=sunutribunal.sn
# Prévenu par Let's Encrypt en cas de problème de certificat
EMAIL_ADMIN=

# ── Secrets (générer, voir docs/DEPLOIEMENT.md) ──
# Lettres et chiffres uniquement (il est mis dans une adresse postgresql://)
POSTGRES_PASSWORD=
SECRET_KEY=

# ── Services externes ───────────────────────────
GROQ_API_KEY=
# E-mails : Brevo (recommandé) ou Gmail
BREVO_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SunuTribunal <noreply@sunutribunal.sn>
# SMS (facultatif) : passerelle Android, Brevo ou Twilio
SMSGATE_LOGIN=
SMSGATE_PASSWORD=
BREVO_SMS_SENDER=SunuTrib
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

CODE_JURIDICTION=TIDK
