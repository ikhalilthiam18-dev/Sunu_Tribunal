# ── SunuTribunal — Variables d'environnement ──────────────────────
# Copiez ce fichier en .env et remplissez les valeurs

# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
DB_NAME=sunutribunal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS — URL du frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (Gmail SMTP) — envoi des identifiants provisoires du personnel
# EMAIL_HOST_PASSWORD = « mot de passe d'application » Gmail (16 caractères), pas votre mot de passe.
# Laisser EMAIL_HOST_USER vide = les e-mails s'affichent dans le terminal (tests sans Gmail).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password
DEFAULT_FROM_EMAIL=SunuTribunal <votre@gmail.com>
# Brevo (recommandé si le Wi-Fi bloque le SMTP) : clé « API key » de brevo.com (SMTP & API → API Keys).
# Renseignée, elle remplace Gmail SMTP. DEFAULT_FROM_EMAIL doit être un expéditeur validé dans Brevo.
BREVO_API_KEY=

# Adresse de la plateforme utilisée dans les e-mails (bouton « Accéder à SunuTribunal »)
FRONTEND_URL=https://votre-lien-public.ngrok-free.dev

# Firebase (notifications push)
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json

# SMS GRATUITS par votre téléphone Android (prioritaire sur Brevo et Twilio) :
# installez « SMS Gateway for Android » (https://sms-gate.app), activez « Cloud server »,
# puis recopiez ici l'identifiant et le mot de passe affichés dans l'application.
SMSGATE_LOGIN=
SMSGATE_PASSWORD=

# SMS par Brevo (prioritaire sur Twilio) : utilise BREVO_API_KEY ci-dessus + crédits SMS achetés dans Brevo.
# Nom affiché comme expéditeur : 11 caractères max, lettres et chiffres, sans espace.
BREVO_SMS_SENDER=SunuTrib
# Twilio (SMS réels — confirmation / rejet des rendez-vous)
# Console Twilio → Account Info. Laisser vide = SMS non envoyés (inscrits au journal).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Code de la juridiction dans les numéros de registre (si l'agent n'a pas de tribunal)
# Ex : CA-00142/2026/TIDK
CODE_JURIDICTION=TIDK

# Google Maps API
VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key
